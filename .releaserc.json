{
	"branches": [
		"main",
		{
			"name": "develop",
			"prerelease": true
		}
	],
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		"@semantic-release/changelog",
		[
			"@semantic-release/npm",
			{
				"npmPublish": false
			}
		],
		[
			"@codedependant/semantic-release-docker",
			{
				"dockerImage": "tesla-live-share",
				"dockerTags": [
					"{{#if prerelease.[0]}}{{prerelease.[0]}}{{else}}latest{{/if}}",
					"{{major}}-{{#if prerelease.[0]}}{{prerelease.[0]}}{{else}}latest{{/if}}",
					"{{major}}.{{minor}}-{{#if prerelease.[0]}}{{prerelease.[0]}}{{else}}latest{{/if}}",
					"{{version}}"
				],
				"dockerArgs": {
					"CONVEX_DEPLOY_KEY": true,
					"PUBLIC_CONVEX_URL": true,
					"PUBLIC_CONVEX_SITE_URL": true
				}
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": ["CHANGELOG.md", "package.json"],
				"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
			}
		],
		"@semantic-release/github"
	]
}
