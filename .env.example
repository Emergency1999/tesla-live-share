# Convex Configuration
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# OIDC Authentication Configuration
VITE_AUTH_ISSUER_URL=https://your-oidc-provider.com
VITE_AUTH_CLIENT_ID=your-client-id
VITE_AUTH_REDIRECT_URI=https://tesla.example.de

# These are set in the Convex Dashboard:
# AUTH_ISSUER_URL - The OIDC issuer URL for JWT verification
# AUTH_APPLICATION_ID - The application/audience ID for JWT verification
# CAR_VIN - Your Tesla's VIN number
# TESSIE_ACCESS_TOKEN - Your Tessie API access token
